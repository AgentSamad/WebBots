{
  "name": "boom-arena-bot",
  "version": "1.0.0",
  "description": "Daily bot + crash monitoring for Boom Arena on CrazyGames",
  "main": "scheduler.js",
  "scripts": {
    "start": "node scheduler.js",
    "bot": "node bot.js",
    "multi": "node multiBot.js",
    "multi:fast": "node multiBot.js --batch 10",
    "test": "npx playwright test",
    "test:report": "npx playwright show-report",
    "dashboard": "node server.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "node-schedule": "^2.1.1",
    "nodemailer": "^6.9.16",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  }
}
