# ── Node.js ──────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
*.log

# ── Generated output (run-time, not source) ──────────────────────────────────
reports/
screenshots/

# ── Browser profiles (large local state — each PC builds its own) ────────────
user-profiles/

# ── VPN / network ────────────────────────────────────────────────────────────
*.ovpn
# proxies.txt is committed — edit per-machine after pull

# ── Env / secrets ────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Claude Code session data ──────────────────────────────────────────────────
.claude/

# ── OS junk ──────────────────────────────────────────────────────────────────
Thumbs.db
.DS_Store
desktop.ini
